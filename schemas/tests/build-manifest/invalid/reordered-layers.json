       "mask": "bc4"
      },
      "mips": "full-chain",
      "evidence": [
       "EXP-014",
       "RD-006"
      ],
      "notes": "KTX2 reader validated against the Khronos tool (EXP-014); in-engine render test pending."
     }
    ],
