{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Handelsonderneming-S-D-Broekhoven/SSTRE/schemas/layer-approvals.schema.json",
  "title": "SSTRE per-asset approvals for the opt-in HD Artwork and HD Interface layers",
  "$comment": "STATUS: PROPOSAL (sprint 2, track A2, EXP-015; ADR-0009 layers 4 and 5). An asset enters layer 4 or 5 only if that layer is opted in in the build-config AND an entry here approves the exact candidate (optionally pinned by hash). Approvals are curated artistic choices (SSTRE-Manifests, CC-BY-SA-4.0) but reference proprietary asset IDs: real files stay local until GATE-05. Examples are synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["approvalsFormatVersion", "approvalsId", "approvals"],
  "properties": {
    "$comment": { "type": "string" },
    "approvalsFormatVersion": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "approvalsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "description": { "type": "string" },
    "localOnly": { "type": "boolean" },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "layer", "candidateId", "decision"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "layer": { "enum": ["hd-artwork", "hd-interface"] },
          "candidateId": { "type": "string", "minLength": 1 },
          "candidateSha256": { "$ref": "build-provenance.schema.json#/$defs/sha256", "description": "Pins the approved candidate file; a changed file makes the approval stale." },
          "decision": { "enum": ["approved", "rejected"] },
          "priority": { "type": "integer", "minimum": -1000000, "maximum": 1000000, "description": "Breaks ties between several approved candidates for one asset (higher wins, then candidateId)." },
          "approvedBy": { "type": "string" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "examples": [
    {
      "$comment": "Synthetic example.",
      "approvalsFormatVersion": "0.1.0",
      "approvalsId": "synthetic",
      "approvals": [
        { "assetId": "synthetic:textures/test/statue.tex", "layer": "hd-artwork", "candidateId": "synthetic-hd:textures/test/statue", "decision": "approved", "approvedBy": "owner", "date": "2026-11-27" },
        { "assetId": "synthetic:textures/interface/logo.tex", "layer": "hd-interface", "candidateId": "synthetic-hd:textures/interface/logo", "decision": "rejected" }
      ]
    }
  ]
}
