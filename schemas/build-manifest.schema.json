{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Handelsonderneming-S-D-Broekhoven/SSTRE/schemas/build-manifest.schema.json",
  "title": "SSTRE effective build manifest (frozen configuration + resolved per-asset layer plan)",
  "$comment": "STATUS: PROPOSAL (sprint 2, track A2, EXP-015; ADR-0009 rules 2 and 3, ADR-0003). Written by 'sstre-ac plan'. effectiveConfig freezes everything the plan depends on (layers, quality and platform profiles, approvals, packs by version and hash, the source-selection record set by hash). Per asset it records which layer supplied the source, which layer processed it, the source ID and hash, the selection rule and scores (source-selection.schema.json) and the platform-profile result. Hashes: sha256 over RFC 8785 JCS. effectiveConfigHash = H(effectiveConfig); planHash = H({effectiveConfig, assets}); conflicts and summary are derived and excluded. Real manifests reference proprietary assets and stay local until GATE-05; examples are synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestFormatVersion",
    "kind",
    "generator",
    "layerOrder",
    "effectiveConfig",
    "effectiveConfigHash",
    "assets",
    "conflicts",
    "summary",
    "planHash",
    "localOnly"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "manifestFormatVersion": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "sstre-build-manifest"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "layerOrder": {
      "description": "The fixed ADR-0009 order.",
      "const": [
        "classic-base",
        "hd-quality",
        "hd-material-maps",
        "hd-artwork",
        "hd-interface",
        "ai-enhancement",
        "overrides"
      ]
    },
    "effectiveConfig": {
      "$ref": "#/$defs/effectiveConfig"
    },
    "effectiveConfigHash": {
      "$ref": "#/$defs/sha256"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "kind",
          "chosen"
        ],
        "properties": {
          "assetId": {
            "$ref": "#/$defs/assetId"
          },
          "kind": {
            "enum": [
              "multiple-selection-records"
            ]
          },
          "chosen": {
            "type": "string"
          },
          "others": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Derived aggregate counts; not part of planHash."
    },
    "planHash": {
      "$ref": "#/$defs/sha256"
    },
    "localOnly": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "build-provenance.schema.json#/$defs/sha256"
    },
    "layerId": {
      "$ref": "build-config.schema.json#/$defs/layerId"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "packInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "version",
        "kind",
        "priority",
        "sha256",
        "entryCount"
      ],
      "properties": {
        "packId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ai-enhancement",
            "curated",
            "community"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entryCount": {
          "type": "integer",
          "minimum": 0
        },
        "qualityProfile": {
          "type": "string"
        }
      }
    },
    "effectiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configId",
        "configFormatVersion",
        "configHash",
        "layers",
        "qualityProfile",
        "platformProfile",
        "approvals",
        "overridePacks",
        "aiPacks",
        "selection",
        "assetFacts"
      ],
      "properties": {
        "configId": {
          "type": "string"
        },
        "configFormatVersion": {
          "type": "string"
        },
        "configHash": {
          "$ref": "#/$defs/sha256",
          "description": "JCS hash of the build-config document as given."
        },
        "layers": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "order",
              "enabled"
            ],
            "properties": {
              "layer": {
                "$ref": "#/$defs/layerId"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "enabled": {
                "type": "boolean"
              },
              "qualityProfile": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "$ref": "platform-profile.schema.json#/$defs/mapRole"
                }
              },
              "includeRelayout": {
                "type": "boolean"
              },
              "requiresApproval": {
                "const": true
              }
            }
          }
        },
        "qualityProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "hash",
            "definition"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "hash": {
              "$ref": "#/$defs/sha256"
            },
            "definition": {
              "$ref": "build-config.schema.json#/$defs/qualityProfile"
            }
          }
        },
        "platformProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status",
            "hash",
            "profile"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "validated",
                "provisional",
                "hypothetical"
              ]
            },
            "hash": {
              "$ref": "#/$defs/sha256"
            },
            "profile": {
              "$ref": "platform-profile.schema.json"
            }
          }
        },
        "approvals": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approvalsId",
                "sha256",
                "count",
                "entries"
              ],
              "properties": {
                "approvalsId": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "assetId",
                      "layer",
                      "candidateId",
                      "decision",
                      "priority"
                    ],
                    "properties": {
                      "assetId": {
                        "$ref": "#/$defs/assetId"
                      },
                      "layer": {
                        "enum": [
                          "hd-artwork",
                          "hd-interface"
                        ]
                      },
                      "candidateId": {
                        "type": "string"
                      },
                      "candidateSha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "decision": {
                        "enum": [
                          "approved",
                          "rejected"
                        ]
                      },
                      "priority": {
                        "type": "integer"
                      },
                      "approvedBy": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "overridePacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packInfo"
          }
        },
        "aiPacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packInfo"
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordCount",
            "recordSetHash",
            "policies"
          ],
          "properties": {
            "recordCount": {
              "type": "integer",
              "minimum": 0
            },
            "recordSetHash": {
              "$ref": "#/$defs/sha256",
              "description": "JCS hash of the sorted list of record hashes (each record without generated_at)."
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "policyId",
                  "version",
                  "thresholdsHash",
                  "records"
                ],
                "properties": {
                  "policyId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "thresholdsHash": {
                    "$ref": "#/$defs/sha256"
                  },
                  "records": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "assetFacts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "onlyListed"
              ],
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "onlyListed": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "assetScope": {
          "description": "Optional asset scope (e.g. the textures named by given levels, 'sstre-ac level-scope', EXP-019): the plan covers exactly these asset IDs.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetIds",
            "idsHash",
            "sources"
          ],
          "properties": {
            "assetIds": {
              "type": "integer",
              "minimum": 0
            },
            "idsHash": {
              "$ref": "#/$defs/sha256"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scopeHash",
                  "assets"
                ],
                "properties": {
                  "scopeHash": {
                    "$ref": "#/$defs/sha256"
                  },
                  "edition": {
                    "type": "string"
                  },
                  "levels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assets": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "layerStatus": {
      "enum": [
        "applied",
        "superseded",
        "disabled",
        "awaiting-approval",
        "rejected",
        "blocked",
        "not-applicable",
        "dropped",
        "off",
        "not-eligible",
        "suppressed",
        "source-sufficient",
        "awaiting-output",
        "platform-capped"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "kind",
        "id",
        "decidedBy"
      ],
      "properties": {
        "layer": {
          "enum": [
            "classic-base",
            "hd-quality",
            "hd-artwork",
            "hd-interface",
            "overrides"
          ]
        },
        "kind": {
          "enum": [
            "classic",
            "hd",
            "override"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "imageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "px": {
          "$ref": "#/$defs/size"
        },
        "format": {
          "type": "string"
        },
        "decidedBy": {
          "$ref": "#/$defs/layerId"
        },
        "layoutChanged": {
          "type": "boolean"
        },
        "keepMaps": {
          "type": "boolean"
        },
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packId",
            "version",
            "kind"
          ],
          "properties": {
            "packId": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "curated",
                "community"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "layer": {
                "const": "classic-base"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "classic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "enum": [
                  "hd-quality",
                  "hd-artwork",
                  "hd-interface"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "hd"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "layer": {
                "const": "overrides"
              }
            }
          },
          "then": {
            "required": [
              "pack",
              "sha256"
            ],
            "properties": {
              "kind": {
                "const": "override"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "category",
        "classic",
        "selection",
        "source",
        "suppliedBy",
        "processedBy",
        "materialMaps",
        "processing",
        "layers",
        "platform"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/assetId"
        },
        "category": {
          "$ref": "source-selection.schema.json#/properties/category"
        },
        "classic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "imageSha256": {
              "$ref": "#/$defs/sha256"
            },
            "px": {
              "$ref": "#/$defs/size"
            },
            "alphaMode": {
              "enum": [
                "opaque",
                "cutout",
                "blend",
                "none"
              ]
            },
            "firstMip": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recordId",
                "recordSha256",
                "policyId",
                "policyVersion",
                "result",
                "ruleFired",
                "candidateId",
                "scores"
              ],
              "properties": {
                "recordId": {
                  "$ref": "source-selection.schema.json#/properties/record_id"
                },
                "recordSha256": {
                  "$ref": "#/$defs/sha256",
                  "description": "JCS hash of the record without generated_at."
                },
                "policyId": {
                  "type": "string"
                },
                "policyVersion": {
                  "type": "string"
                },
                "result": {
                  "$ref": "source-selection.schema.json#/$defs/decision/properties/result"
                },
                "ruleFired": {
                  "$ref": "source-selection.schema.json#/$defs/rule_id"
                },
                "candidateId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scores": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "suppliedBy": {
          "enum": [
            "classic-base",
            "hd-quality",
            "hd-artwork",
            "hd-interface",
            "overrides"
          ]
        },
        "processedBy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": "ai-enhancement"
            }
          ]
        },
        "materialMaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "layer",
              "id"
            ],
            "properties": {
              "role": {
                "$ref": "platform-profile.schema.json#/$defs/mapRole"
              },
              "layer": {
                "enum": [
                  "hd-material-maps",
                  "ai-enhancement",
                  "overrides"
                ]
              },
              "id": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "px": {
                "$ref": "#/$defs/size"
              },
              "pxAssumed": {
                "type": "boolean"
              },
              "inferred": {
                "type": "boolean"
              }
            }
          }
        },
        "processing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layer",
            "qualityProfile",
            "status"
          ],
          "properties": {
            "layer": {
              "const": "ai-enhancement"
            },
            "qualityProfile": {
              "type": "string"
            },
            "status": {
              "enum": [
                "off",
                "not-eligible",
                "suppressed",
                "source-sufficient",
                "platform-capped",
                "awaiting-output",
                "applied"
              ]
            },
            "mode": {
              "$ref": "build-config.schema.json#/$defs/aiMode"
            },
            "scale": {
              "type": "integer",
              "minimum": 1
            },
            "plannedPx": {
              "$ref": "#/$defs/size",
              "description": "Target size the AI output should have, already clamped to the platform profile."
            },
            "plannedClampedFrom": {
              "$ref": "#/$defs/size"
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packId",
                "version",
                "sha256",
                "px",
                "recipeHash"
              ],
              "properties": {
                "packId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "px": {
                  "$ref": "#/$defs/size"
                },
                "recipeHash": {
                  "$ref": "#/$defs/sha256"
                },
                "provenanceSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "rejectedOutputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "applied"
                  }
                }
              },
              "then": {
                "required": [
                  "output",
                  "mode",
                  "scale"
                ]
              }
            }
          ]
        },
        "layers": {
          "description": "Status of every layer for this asset, in the fixed order.",
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "order",
              "status"
            ],
            "properties": {
              "layer": {
                "$ref": "#/$defs/layerId"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "status": {
                "$ref": "#/$defs/layerStatus"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "textures",
            "actions"
          ],
          "properties": {
            "profileId": {
              "type": "string"
            },
            "classicPx": {
              "$ref": "#/$defs/size"
            },
            "textures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "inputPx",
                  "targetPx",
                  "formats",
                  "preprocessing"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "albedo",
                      "normal",
                      "gloss",
                      "ao",
                      "height"
                    ]
                  },
                  "inputPx": {
                    "$ref": "#/$defs/size"
                  },
                  "targetPx": {
                    "$ref": "#/$defs/size"
                  },
                  "formats": {
                    "description": "Format per platform target; null = the target does not take this role.",
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "platform-profile.schema.json#/$defs/format"
                        }
                      ]
                    }
                  },
                  "preprocessing": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "plannedPx": {
                    "$ref": "#/$defs/size",
                    "description": "Size once the awaited AI output exists (counted by the memory budget)."
                  }
                }
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "first-mip-density-cap",
                      "round-down-power-of-two",
                      "downscale",
                      "below-classic-resolution",
                      "budget-halve",
                      "size-unknown"
                    ]
                  },
                  "role": {
                    "type": "string"
                  },
                  "from": {
                    "$ref": "#/$defs/size"
                  },
                  "to": {
                    "$ref": "#/$defs/size"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            },
            "estimatedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "provenance": {
          "description": "Filled by the build step after processing (not by the planner).",
          "$ref": "build-provenance.schema.json"
        }
      }
    }
  },
  "examples": [
    {
      "$comment": "Synthetic example: one invented asset; hashes are SHA-256 of 'SSTRE synthetic fixture: <label>' or JCS hashes of synthetic documents.",
      "manifestFormatVersion": "0.1.0",
      "kind": "sstre-build-manifest",
      "generator": {
        "name": "sstre-assetcompiler",
        "version": "0.1.0.dev0"
      },
      "layerOrder": [
        "classic-base",
        "hd-quality",
        "hd-material-maps",
