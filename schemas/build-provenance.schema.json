{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Handelsonderneming-S-D-Broekhoven/SSTRE/schemas/build-provenance.schema.json",
  "$comment": "STATUS: PROPOSAL (Phase 0, 2026-11-27, Agent C). Not an accepted contract. Per-asset build output provenance / lock record. Concepts borrowed from SLSA provenance v1 and in-toto (https://slsa.dev/spec/v1.0/provenance); this is NOT a SLSA-compliant attestation. Hashes are 'sha256:<hex>'; hashed JSON uses RFC 8785 JCS. See docs/research/RD-004-reproducibility.md.",
  "title": "SSTRE per-asset build provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenanceFormatVersion", "assetId", "status", "assetKey", "input", "recipe", "environment", "outputs", "qa", "fallback"],
  "properties": {
    "$comment": { "type": "string" },
    "provenanceFormatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "assetId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "enum": ["succeeded", "succeeded-with-fallback", "failed", "skipped-cached"] },
    "assetKey": {
      "description": "Asset-level content-addressed cache key (RD-004 section 6).",
      "$ref": "#/$defs/sha256"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHash"],
      "properties": {
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "sourceKind": { "enum": ["classic", "hd-remaster", "curated-replacement"] },
        "gameEdition": { "description": "Edition id from RD-002 (e.g. tfe-classic-steam); no proprietary content.", "type": "string" },
        "archiveHash": { "$ref": "#/$defs/sha256" },
        "inventoryRecordHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvedRecipeHash", "recipeFormatVersion"],
      "properties": {
        "resolvedRecipeHash": { "$ref": "#/$defs/sha256" },
        "recipeFormatVersion": { "type": "string" },
        "precedenceSource": {
          "description": "Highest-precedence layer that contributed to the resolved recipe.",
          "enum": ["global-defaults", "material-profile", "generated-recipe", "curated-override"]
        },
        "layerHashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "hash"],
            "properties": {
              "layer": { "enum": ["global-defaults", "material-profile", "generated-recipe", "curated-override"] },
              "ref": { "type": "string" },
              "hash": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "manifestsCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targetProfile": { "type": "string" },
        "targetProfileHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "steps": {
      "description": "Per-step execution records, in execution order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "stepKey", "cacheHit"],
        "properties": {
          "stepId": { "type": "string" },
          "stepKey": { "$ref": "#/$defs/sha256" },
          "cacheHit": { "type": "boolean" },
          "inputHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
          "outputHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
          "decodedPixelHash": { "description": "Hash of raw decoded pixel buffer (separates encoder from compute nondeterminism).", "$ref": "#/$defs/sha256" },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "hash"],
              "properties": {
                "role": { "type": "string" },
                "hash": { "$ref": "#/$defs/sha256" },
                "verified": { "description": "True if file bytes were re-hashed and matched before use.", "type": "boolean" },
                "licenseId": { "type": "string" }
              }
            }
          },
          "runtimeClass": { "description": "Equivalence class id used in the step cache key.", "type": "string" },
          "wallTimeSeconds": { "type": "number", "minimum": 0 },
          "modelLoadSeconds": { "type": "number", "minimum": 0 },
          "peakVramBytes": { "type": "integer", "minimum": 0 },
          "deterministicExceptions": {
            "description": "Ops that ran nondeterministically (warnings) or settings deviating from the reference.",
            "type": "array",
            "items": { "type": "string" }
          },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "environment": {
      "description": "Toolchain/runtime identity (builder + internal parameters in SLSA terms).",
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentHash", "executor"],
      "properties": {
        "environmentHash": { "description": "JCS hash of this environment object without environmentHash itself.", "$ref": "#/$defs/sha256" },
        "referenceEnvironmentId": { "type": ["string", "null"] },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "dirty": { "type": "boolean" }
          }
        },
        "os": { "type": "object", "additionalProperties": { "type": "string" } },
        "cpu": { "type": "string" },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vendor": { "type": "string" },
              "name": { "type": "string" },
              "computeCapability": { "type": "string" },
              "smCount": { "type": "integer", "minimum": 0 },
              "vramMiB": { "type": "integer", "minimum": 0 },
              "driverVersion": { "type": "string" }
            }
          }
        },
        "runtimes": {
          "description": "e.g. {\"python\": \"3.10.11\", \"torch\": \"2.15.0\", \"cuda\": \"...\", \"cudnn\": \"...\", \"diffusers\": \"0.43.0\", \"spandrel\": \"0.4.2\"}.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "lockfileHash": { "$ref": "#/$defs/sha256" },
        "containerDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "settings": {
          "description": "Determinism-relevant settings and env vars (e.g. CUBLAS_WORKSPACE_CONFIG, deterministicAlgorithms, warnOnly, cudnnBenchmark, allowTF32, sdpaBackend, rngDevice).",
          "type": "object",
          "additionalProperties": { "type": ["string", "boolean", "number", "null"] }
        },
        "workflowEngine": {
          "description": "If a workflow engine (e.g. ComfyUI) was used: core commit and pinned custom nodes.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "customNodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "gitCommit", "reviewed"],
                "properties": {
                  "name": { "type": "string" },
                  "repo": { "type": "string" },
                  "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "reviewed": { "type": "boolean" },
                  "licenseId": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "hash"],
        "properties": {
          "role": { "type": "string" },
          "hash": { "$ref": "#/$defs/sha256" },
          "decodedPixelHash": { "$ref": "#/$defs/sha256" },
          "mediaType": { "type": "string" },
          "format": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "mipLevels": { "type": "integer", "minimum": 1 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "inferred": { "type": "boolean" }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "results"],
      "properties": {
        "passed": { "type": "boolean" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "value", "passed"],
            "properties": {
              "metric": { "type": "string" },
              "value": { "type": ["number", "string", "null"] },
              "threshold": { "type": ["number", "string", "null"] },
              "comparator": { "enum": ["<=", ">=", "==", null] },
              "reference": { "type": "string" },
              "passed": { "type": "boolean" },
              "attemptId": { "type": "string", "description": "Fallback chain entry id or 'primary'." }
            }
          }
        },
        "toleranceClassClaimed": {
          "description": "Reproducibility tolerance class (RD-004 section 8.3) claimed for this output in this environment.",
          "enum": ["T0", "T1", "T2", "T3", "unmeasured"]
        },
        "humanReview": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "reviewer": { "type": "string" },
            "decision": { "enum": ["approved", "rejected", "needs-override"] },
            "notesRef": { "type": "string" }
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used"],
      "properties": {
        "used": { "type": "boolean" },
        "selectedAttemptId": { "type": "string", "description": "'primary' or fallbackPolicy.chain[].id" },
        "selectedMode": { "enum": ["primary", "skip-optional-steps", "alternate-steps", "conventional-resample", "original"] },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attemptId", "outcome"],
            "properties": {
              "attemptId": { "type": "string" },
              "outcome": { "enum": ["passed", "gate-failed", "error", "not-run"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "run": {
      "description": "Run metadata; excluded from all cache keys and lock-identity comparisons.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invocationId": { "type": "string" },
        "startedOn": { "type": "string", "format": "date-time" },
        "finishedOn": { "type": "string", "format": "date-time" },
        "resumedFrom": { "type": ["string", "null"] },
        "logRef": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "examples": [
    {
