# Normalize line endings so Windows and Linux contributors produce identical
# text files (and identical hashes for canonicalized manifests/schemas).
* text=auto eol=lf

*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf
*.ps1    text eol=crlf

*.png    binary
*.jpg    binary
*.svg    text eol=lf
